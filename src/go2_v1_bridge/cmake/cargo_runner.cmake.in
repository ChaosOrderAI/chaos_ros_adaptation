cmake_minimum_required(VERSION 3.20)

# Generated by CMake. All Cargo compilation artifacts stay in the colcon build
# directory; no sibling source checkout or machine-local Cargo config is used.
# r2r gives CMAKE_IDL_PACKAGES priority over the ament index. Clear unrelated
# callers' lists so this package's explicit IDL filter remains authoritative.
unset(ENV{CMAKE_IDL_PACKAGES})
# CMake's execute_process does not inherit Make's jobserver file descriptors.
# Cargo creates its own jobserver with the explicit --jobs limit below.
unset(ENV{MAKEFLAGS})
unset(ENV{MFLAGS})
unset(ENV{CARGO_MAKEFLAGS})
set(ENV{IDL_PACKAGE_FILTER} [==[@GO2_V1_IDL_PACKAGES@]==])
if(NOT DEFINED ENV{BINDGEN_EXTRA_CLANG_ARGS})
  set(_compiler_include [==[@GO2_V1_COMPILER_INCLUDE@]==])
  if(NOT _compiler_include STREQUAL "")
    set(ENV{BINDGEN_EXTRA_CLANG_ARGS} "-I${_compiler_include}")
  endif()
endif()

if(GO2_V1_RUN_TESTS)
  set(_cargo_action test --all-targets)
else()
  set(_cargo_action build --bin go2_v1_bridge)
endif()
set(_cargo_flags
  --locked --release
  --manifest-path [==[@CMAKE_CURRENT_SOURCE_DIR@/Cargo.toml]==]
  --target-dir [==[@GO2_V1_CARGO_TARGET_DIR@]==]
  --target [==[@GO2_V1_RUST_HOST@]==]
  --jobs @GO2_V1_BUILD_JOBS@)
if(@GO2_V1_OFFLINE@)
  list(APPEND _cargo_flags --offline)
endif()
execute_process(
  COMMAND [==[@GO2_V1_CARGO@]==] ${_cargo_action} ${_cargo_flags}
  WORKING_DIRECTORY [==[@CMAKE_CURRENT_BINARY_DIR@]==]
  COMMAND_ERROR_IS_FATAL ANY)

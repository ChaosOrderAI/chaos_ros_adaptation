<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chaos_skill</name>
  <version>0.1.0</version>
  <description>Discrete skill vocabulary with hub-state pre/postconditions on top of chaos_sdk.</description>
  <maintainer email="maintainer@example.com">Chaos maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gtest</buildtool_depend>

  <depend>chaos_core</depend>
  <depend>chaos_interfaces</depend>
  <depend>chaos_sdk</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nlohmann-json-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

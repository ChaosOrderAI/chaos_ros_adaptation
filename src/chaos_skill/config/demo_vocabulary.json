{
  "hub_states": ["idle", "carrying", "airborne", "failed"],
  "skills": [
    {
      "token": "takeoff",
      "description": "Lift off to the given altitude",
      "entry_hub": "idle",
      "exit_hub": "airborne",
      "capability": "motion",
      "needs_lease": true,
      "arguments_schema": {"altitude_m": {"type": "number", "description": "target altitude in metres"}}
    },
    {
      "token": "land",
      "description": "Descend and touch down",
      "entry_hub": "airborne",
      "exit_hub": "idle",
      "capability": "motion",
      "needs_lease": true,
      "arguments_schema": {}
    },
    {
      "token": "navigate_to",
      "description": "Move to the given base-frame pose",
      "entry_hub": "idle",
      "exit_hub": "idle",
      "capability": "navigation",
      "needs_lease": true,
      "arguments_schema": {
        "x": {"type": "number", "description": "metres forward"},
        "y": {"type": "number", "description": "metres left"},
        "yaw": {"type": "number", "description": "heading radians", "default": 0}
      }
    },
    {
      "token": "stop",
      "description": "Stop motion now. If another skill is running, cancel it and stop; this token is not rejected as busy",
      "entry_hub": "idle",
      "exit_hub": "idle",
      "capability": "motion",
      "needs_lease": true,
      "any_entry_hub": true,
      "arguments_schema": {}
    },
    {
      "token": "observe",
      "description": "Read the robot state and the newest sample of the configured sensor streams",
      "entry_hub": "idle",
      "exit_hub": "idle",
      "capability": "sensor",
      "needs_lease": false,
      "any_entry_hub": true,
      "arguments_schema": {
        "streams": {
          "type": "array",
          "description": "sensor streams to read; empty means every configured stream",
          "items": {"type": "string"}
        }
      }
    },
    {
      "token": "announce",
      "description": "Send a message on the external communication channel",
      "entry_hub": "idle",
      "exit_hub": "idle",
      "capability": "communication",
      "needs_lease": false,
      "any_entry_hub": true,
      "arguments_schema": {
        "topic": {"type": "string", "description": "logical topic of the announcement", "default": "status"},
        "payload": {"type": "object", "description": "announcement payload"}
      }
    },
    {
      "token": "hold",
      "description": "Remain in the current hub for one step",
      "entry_hub": "idle",
      "exit_hub": "idle",
      "capability": "motion",
      "needs_lease": false,
      "any_entry_hub": true,
      "arguments_schema": {}
    }
  ]
}

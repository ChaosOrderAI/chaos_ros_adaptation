  <test_depend>ament_cmake_test</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>chaos_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chaos_bt</name>
  <version>0.1.0</version>
  <description>BehaviorTree.CPP nodes for the native chaos_sdk action client.</description>
  <maintainer email="maintainer@example.com">Chaos maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gtest</buildtool_depend>

  <depend>chaos_sdk</depend>
  <depend>geometry_msgs</depend>

<?xml version="1.0"?>
<package format="3">
  <name>chaos_runtime</name><version>0.1.0</version>
  <description>Asset-scoped robot runtime and adapter plugins.</description>
  <maintainer email="maintainer@example.com">Chaos maintainers</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>chaos_core</depend>
  <depend>chaos_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <!-- The public headers expose the nlohmann JSON type. -->
  <depend>nlohmann-json-dev</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chaos_bringup</name>
  <version>0.1.0</version>
  <description>Native launch planner and ROS launch glue for the chaos fleet.</description>
  <maintainer email="maintainers@example.com">Chaos maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>chaos_assets</depend>
  <depend>nlohmann_json</depend>

  <exec_depend>chaos_mqtt</exec_depend>
  <exec_depend>chaos_runtime</exec_depend>
  <exec_depend>chaos_sensors</exec_depend>
  <exec_depend>chaos_skill</exec_depend>
  <exec_depend>chaos_data</exec_depend>
  <exec_depend>chaos_time_sync</exec_depend>
  <exec_depend>chaos_camera_trigger</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

{
  "mqtt": {
    "host": "127.0.0.1",
    "port": 8883,
    "client_id": "robot-dog-2",
    "username": "go2-01",
    "ca_file": "/etc/mqtt_ros2_adapter/certs/ca.crt",
    "client_certificate_file": "/etc/mqtt_ros2_adapter/certs/go2-01.crt",
    "client_key_file": "/etc/mqtt_ros2_adapter/certs/go2-01.key",
    "command_topic": "go2/002/_legacy/command",
    "response_topic": "go2/002/_legacy/response",
    "event_topic": "go2/002/_legacy/event"
  },
  "network": {"access": "system"},
  "ros2": {"topic_prefix": "v1"},
  "route_profile": "custom",
  "routes": [],
  "topic_mappings": [
    {"name": "cmd_dl", "direction": "mqtt_to_ros2",
     "mqtt_topic": "go2/002/cmd", "ros_topic": "/v1/cmd",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}},
    {"name": "nav_cmd_dl", "direction": "mqtt_to_ros2",
     "mqtt_topic": "go2/002/nav_cmd", "ros_topic": "/v1/nav_cmd",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}},
    {"name": "mgmt_cmd_dl", "direction": "mqtt_to_ros2",
     "mqtt_topic": "go2/002/mgmt_cmd", "ros_topic": "/v1/mgmt_cmd",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}},

    {"name": "resp_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/resp", "mqtt_topic": "go2/002/resp",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}, "delivery": "queued"},
    {"name": "nav_resp_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/nav_resp", "mqtt_topic": "go2/002/nav_resp",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}, "delivery": "queued"},
    {"name": "mgmt_resp_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/mgmt_resp", "mqtt_topic": "go2/002/mgmt_resp",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}, "delivery": "queued"},
    {"name": "nav_event_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/nav_event", "mqtt_topic": "go2/002/nav_event",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1}, "delivery": "queued"},

    {"name": "status_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/status", "mqtt_topic": "go2/002/status",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 1, "retain": true},
     "delivery": "queued"},

    {"name": "state_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/state", "mqtt_topic": "go2/002/state",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 0},
     "delivery": "latest", "max_rate_hz": 5.0},
    {"name": "nav_state_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/nav_state", "mqtt_topic": "go2/002/nav_state",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 0},
     "delivery": "latest", "max_rate_hz": 10.0},
    {"name": "detections_ul", "direction": "ros2_to_mqtt",
     "ros_topic": "/v1/detections", "mqtt_topic": "go2/002/detections",
     "msg_type": "std_msgs/msg/String", "mqtt": {"qos": 0},
     "delivery": "latest", "max_rate_hz": 5.0}
  ]
}

# systemd EnvironmentFile syntax: KEY=value, no "export" or shell expansion.
ROS_SETUP=/opt/ros/jazzy/setup.bash
# Optional custom interface workspace, installed somewhere the service can read.
# ROS_OVERLAY_SETUP=/opt/robot_ws/install/setup.bash
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
RUST_LOG=info
ADAPTER_CONFIG=/etc/mqtt_ros2_adapter/config.json

# Only needed when mqtt.username is nonempty and the broker requires a password.
# Match the name configured by mqtt.password_environment.
# MQTT_PASSWORD="replace-with-device-password"

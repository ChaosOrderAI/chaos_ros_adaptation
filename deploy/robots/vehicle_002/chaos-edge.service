[Unit]
Description=Chaos ROS 2 telemetry for vehicle_002
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=exec
User=cas
Group=cas
WorkingDirectory=/var/lib/chaos
StateDirectory=chaos
StateDirectoryMode=0750
LogsDirectory=chaos
LogsDirectoryMode=0750
Environment=ROS_HOME=/var/lib/chaos/ros
Environment=ROS_LOG_DIR=/var/log/chaos
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
EnvironmentFile=/etc/chaos/edge.env
ExecStart=/opt/chaos/deploy/start-edge.sh
Restart=always
RestartSec=5s
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=50s
UMask=0027
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chaos-edge

[Install]
WantedBy=multi-user.target

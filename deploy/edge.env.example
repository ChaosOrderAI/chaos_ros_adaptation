# Loaded by systemd. Values are literal; no ~, $VAR or shell substitutions.
CHAOS_ROS_SETUP=/opt/ros/jazzy/setup.bash
# Optional separately built sensor drivers, sourced before the framework.
# CHAOS_DRIVER_SETUP=/opt/chaos/drivers/local_setup.bash
CHAOS_OVERLAY_SETUP=/opt/chaos/ros/local_setup.bash
CHAOS_INVENTORY=/etc/chaos/asset.yaml
CHAOS_ASSET_ID=vehicle_001
CHAOS_ENABLE_MQTT=true
CHAOS_DISCOVERY_RANGE=LOCALHOST
# Optional broker password, when configured; keep this file mode 0640 or tighter.
# MQTT_PASSWORD=replace-with-device-credential

<?xml version="1.0"?>
<package format="3">
  <name>chaos_benchmarks</name>
  <version>0.1.0</version>
  <description>Release microbenchmarks for migrated C++ domain hot paths. Not a production entry point.</description>
  <maintainer email="maintainers@example.com">Chaos maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>chaos_core</depend>
  <depend>chaos_runtime</depend>
  <depend>chaos_sensors</depend>
  <depend>nlohmann-json</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
